# Copy to .env.<your Firebase project ID>; that file is not tracked.
# None of these are secret. The private key goes in Secret Manager:
#   firebase functions:secrets:set APNS_PRIVATE_KEY --data-file AuthKey_<KEY ID>.p8

# Key ID of the APNs auth key (Certificates, Identifiers & Profiles › Keys).
APNS_KEY_ID=
# The Apple Developer team that owns the key.
APNS_TEAM_ID=
# The iOS app's bundle ID, for example com.example.aucorsa.
APNS_BUNDLE_ID=
